DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SSL_REDIRECT=false
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3001
